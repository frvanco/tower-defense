generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  pseudo       String
  joinNumber   Int       @unique @default(autoincrement())
  email        String?   @unique
  passwordHash String?
  isGuest      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]

  @@unique([pseudo, joinNumber])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
